{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Linux Native Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/FirmwarePicoRiscV/firmware/firmware.elf",
      "cwd": "${workspaceFolder}/FirmwarePicoRiscV",
      "stopAtEntry": true,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",  // Usa el GDB del sistema
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
